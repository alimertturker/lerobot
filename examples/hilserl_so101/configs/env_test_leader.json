{
  "env": {
    "name": "real_robot",
    "fps": 10,
    "task": "pick_and_place",
    "robot": {
      "type": "so101_follower",
      "port": "set-in-local.env",
      "id": "follower",
      "use_degrees": true,
      "cameras": {
        "wrist": {
          "type": "opencv",
          "index_or_path": 0,
          "width": 640,
          "height": 480,
          "fps": 30
        },
        "top": {
          "type": "opencv",
          "index_or_path": 1,
          "width": 640,
          "height": 480,
          "fps": 30
        }
      }
    },
    "teleop": {
      "type": "so101_leader",
      "port": "set-in-local.env",
      "id": "leader",
      "use_degrees": true
    },
    "processor": {
      "control_mode": "leader",
      "max_gripper_pos": 100,
      "observation": {
        "display_cameras": false,
        "add_joint_velocity_to_observation": true,
        "add_current_to_observation": true,
        "add_ee_pose_to_observation": false
      },
      "image_preprocessing": {
        "crop_params_dict": null,
        "resize_size": [
          128,
          128
        ]
      },
      "gripper": {
        "use_gripper": true,
        "gripper_penalty": -0.02
      },
      "reset": {
        "fixed_reset_joint_positions": null,
        "reset_time_s": 5.0,
        "release_wait_s": 3.0,
        "control_time_s": 60.0,
        "terminate_on_success": true,
        "home_joint_positions": null
      },
      "inverse_kinematics": {
        "urdf_path": "assets/SO101/so101_new_calib.urdf",
        "target_frame_name": "gripper_frame_link",
        "end_effector_bounds": null,
        "end_effector_step_sizes": {
          "x": 0.02,
          "y": 0.02,
          "z": 0.02
        },
        "joint_step_sizes": {
          "wrist_flex": 9.0,
          "wrist_roll": 9.0
        },
        "joint_bounds": null,
        "max_joint_step_deg": 9.0,
        "max_ik_error_m": 0.005
      },
      "leader_intervention": {
        "pause_key": "space",
        "correction_key": "tab",
        "handover_duration_s": 1.5,
        "max_joint_speed": 90.0,
        "gripper_threshold": 3.0,
        "follow_follower": true
      },
      "reward_classifier": {
        "pretrained_path": null,
        "success_threshold": 0.5,
        "success_reward": 1.0
      }
    }
  },
  "dataset": {
    "repo_id": "local/so101_leader_demos_wrist",
    "task": "Pick up the cube",
    "root": "outputs/datasets/so101_leader_demos_wrist",
    "num_episodes_to_record": 2,
    "push_to_hub": false
  },
  "mode": null,
  "device": "cpu"
}
