# Machine and setup settings for this project. Copy to `local.env` (git-ignored) and fill in:
#   cp local.env.example local.env
# Every script loads it (scripts/common.sh) and passes the values to lerobot as command-line overrides,
# so the JSON configs in configs/ stay the same for everyone.

# Python interpreter with lerobot (branch hilserl-fix, editable install, extras [hilserl,feetech]).
LEROBOT_PYTHON="$HOME/path/to/venv/bin/python"

# Hugging Face user that owns the dataset / policy repos. Leave empty to never push.
HF_USER=""

# Arms. Find the ports with `lerobot-find-port`; on Linux they look like /dev/ttyACM0.
# The ids name the calibration files (~/.cache/huggingface/lerobot/calibration/.../<id>.json).
FOLLOWER_PORT="/dev/ttyACM0"
FOLLOWER_ID="follower"
LEADER_PORT="/dev/ttyACM1"
LEADER_ID="leader"

# Optional directory containing <FOLLOWER_ID>.json and <LEADER_ID>.json directly.
# Empty = use LeRobot's default calibration directory structure.
CALIBRATION_DIR=""

# Cameras: OpenCV index (or a /dev/videoN path). Find them with `lerobot-find-cameras opencv`.
WRIST_CAMERA=0
TOP_CAMERA=1
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30

# Workspace box for the gripper tip, metres in the robot base frame [x, y, z].
# Measure with scripts/find_bounds.sh.
EE_BOUNDS_MIN="[0.12, -0.16, -0.012]"
EE_BOUNDS_MAX="[0.32, 0.02, 0.13]"

# Joint poses in degrees: [shoulder_pan, shoulder_lift, elbow_flex, wrist_flex, wrist_roll, gripper].
# RESET_POSE: where every episode starts; its gripper tip must be inside the box (check with
#   scripts/read_pose.sh). HOME_POSE: folded rest pose both arms go to when a script exits.
RESET_POSE="[1.01, -39.03, 45.98, 34.81, -86.37, 10.8]"
HOME_POSE="[1.01, -39.03, 45.98, 34.81, -86.37, 10.8]"

# Torch devices: mps (Apple GPU), cuda (NVIDIA GPU) or cpu.
LEARNER_DEVICE="mps"
ACTOR_DEVICE="mps"

# Remote learner (optional, scripts/ec2_*.sh): train on a GPU machine reachable over SSH, run the actor here.
# Leave EC2_HOST empty to train locally.
EC2_HOST=""          # user@address, e.g. ubuntu@203.0.113.10
EC2_KEY=""           # SSH private key, e.g. $HOME/Downloads/my-key.pem
EC2_DIR="hilserl"    # folder in the remote home that holds the code, venv and outputs
